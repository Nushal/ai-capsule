# Copy this file to .env for local development and fill in your own values.
# NEVER commit .env. On Render, set these in Environment -> Environment Variables.

# Server
PORT=3000
NODE_ENV=development

# Long random string used to sign the application JWT.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# GitHub OAuth App (GitHub -> Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=paste-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=paste-your-github-oauth-client-secret
# Must exactly match the "Authorization callback URL" in the GitHub OAuth App
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Optional: where the SQLite file is stored (default: ./data/capsules.db)
# DB_PATH=./data/capsules.db
